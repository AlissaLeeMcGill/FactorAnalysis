library(nFactors)
Big5Data = read_sav("big5data.sav")
Big5Data  =  select(Big5Data, -c(race, age, engnat, gender, hand, source, country))
View(Big5Data)
#do the factor analysis
fitBig5<-fa(Big5Data, rotate = "oblimin", fm = 'pa')
#displays results
fitBig5
parallelAnalysis = fa.parallel(Big5Data, fa = "fa", plot = FALSE)
numFactors = parallelAnalysis$nfact
#do the factor analysis for 5
fitBig5_fiveFac<-fa(Big5Data,nfactors = 5, rotate = "oblimin", fm = 'pa')
fitBig5_fiveFac
